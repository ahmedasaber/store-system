# Database Connection (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/el_ma3ras_db?sslmode=require"

# JWT Secret for Authentication (Minimum 32 characters)
JWT_SECRET="super-secret-jwt-key-el-ma3ras-erp-2026-production"
JWT_EXPIRES_IN="15m"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000"

# Server Port and Host
PORT=3000
HOST="0.0.0.0"
NODE_ENV="development"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
